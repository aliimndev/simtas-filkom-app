# ── App ──────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=production

# ── Database (via PgBouncer) ──────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=6432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=simtas_filkom
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# ── Storage (MinIO / S3-compatible) ──────────────────────────────────────
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_DOCUMENTS_BUCKET=simtas-documents
S3_ARCHIVES_BUCKET=simtas-archives

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@filkom.unida.ac.id
EMAIL_FROM_NAME=SIMTAS FILKOM
EMAIL_DEV_MODE=false
FRONTEND_URL=https://simtas.filkom.unida.ac.id

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://simtas.filkom.unida.ac.id

# ── MinIO (internal) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIMUM_8_CHARS
MINIO_REGION=us-east-1

# ── Image tags ───────────────────────────────────────────────────────────
GITHUB_REPO=aliimndev/simtas-filkom-app
IMAGE_TAG=latest
