{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", ".svelte-kit/ambient.d.ts", ".svelte-kit/types/**/$types.d.ts"],
  "exclude": ["node_modules"]
}
